<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard - Worker Booking</title>

<style>
body {
    margin: 0;
    font-family: Arial;
    background: #f2f5f8;
}
header {
    background: #075e54;
    color: white;
    padding: 20px;
    text-align: center;
}
.container {
    padding: 20px;
}
.card {
    background: white;
    padding: 20px;
    margin-bottom: 15px;
    border-radius: 12px;
    box-shadow: 0 2px 7px #ddd;
}
button {
    background: #075e54;
    color: white;
    border: none;
    padding: 13px;
    border-radius: 8px;
    width: 100%;
    margin-top: 10px;
    font-size: 16px;
}
h2 {
    color: #075e54;
}
</style>
</head>

<body>

<header>
<h2>Worker Booking App</h2>
<p>Dashboard</p>
</header>

<div class="container">

<div class="card">
<h2>Welcome!</h2>
<p id="role">Your Account Dashboard</p>
</div>

<div id="customer">

<div class="card">
<h2>👤 Customer Dashboard</h2>
<p>Find and book professional workers.</p>
<button onclick="alert('Worker search coming soon!')">
Find Workers
</button>
</div>

<div class="card">
<h3>📋 My Bookings</h3>
<button onclick="alert('Your bookings will appear here!')">
View Bookings
</button>
</div>

</div>

<div id="worker">

<div class="card">
<h2>🔧 Worker Dashboard</h2>
<p>Manage your work and bookings.</p>
<button onclick="alert('Profile setup coming soon!')">
My Profile
</button>
</div>

<div class="card">
<h3>📋 Job Requests</h3>
<button onclick="alert('Job requests coming soon!')">
View Jobs
</button>
</div>

</div>

<button onclick="location.href='index.html'">
Back to Home
</button>

</div>

<script>
const account = localStorage.getItem("accountType");

if (account === "Worker") {
    document.getElementById("customer").style.display = "none";
    document.getElementById("role").innerText = "Worker Account";
} else {
    document.getElementById("worker").style.display = "none";
    document.getElementById("role").innerText = "Customer Account";
}
</script>

</body>
</html>