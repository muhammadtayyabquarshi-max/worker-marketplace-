<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Workers</title>
<link rel="stylesheet" href="app.css">
</head>

<body>

<header></header>

<main>

<section class="card">

<h1>Find Workers / کاریگر تلاش کریں</h1>

<input id="search" placeholder="Search service or city">

<div id="list">Loading workers...</div>

<p id="msg"></p>

</section>

</main>

<script type="module">

import { db } from "./firebase.js";

import {
  setHeader,
  requireUser
} from "./common.js";

import {
  collection,
  getDocs,
  query,
  where
} from "https://www.gstatic.com/firebasejs/13.2.0/firebase-firestore.js";

const $ = id => document.getElementById(id);

setHeader();

await requireUser();

let workers = [];

try {

  const result = await getDocs(
    query(
      collection(db, "users"),
      where("role", "==", "worker")
    )
  );

  workers = result.docs.map(d => ({
    id: d.id,
    ...d.data()
  }));

  showWorkers();

} catch(error) {

  $("msg").textContent = error.message;

}

function showWorkers() {

  const term = $("search").value.toLowerCase();

  const filtered = workers.filter(worker => {

    const text =
      `${worker.name || ""} ${worker.service || ""} ${worker.city || ""}`;

    return text.toLowerCase().includes(term);

  });

  $("list").innerHTML = filtered.length
    ? filtered.map(worker => `

      <div class="item">

        <h3>${worker.name || "Worker"}</h3>

        <p>Service: ${worker.service || "Not added"}</p>

        <p>City: ${worker.city || "Not added"}</p>

        <a class="btn"
          href="bookings.html?worker=${encodeURIComponent(worker.id)}">
          Request Booking
        </a>

      </div>

    `).join("")
    : "No workers found.";

}

$("search").oninput = showWorkers;

</script>

</body>
</html>